import { useMemo } from "react";
import Map, {
  Layer,
  Marker,
  NavigationControl,
  Popup,
  Source,
} from "react-map-gl/maplibre";
import "maplibre-gl/dist/maplibre-gl.css";

function riskColor(severity) {
  switch (String(severity || "").toUpperCase()) {
    case "CRITICAL":
      return "#ef4444";
    case "HIGH":
      return "#ff5b63";
    case "MODERATE":
    case "MEDIUM":
      return "#f5c344";
    case "LOW":
      return "#2bd58d";
    default:
      return "#20b8f2";
  }
}

const MAP_STYLE = {
  version: 8,
  sources: {
    satellite: {
      type: "raster",
      tiles: [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      ],
      tileSize: 256,
      attribution: "Esri, Maxar, Earthstar Geographics",
    },
    terrain: {
      type: "raster-dem",
      url: "https://demotiles.maplibre.org/terrain-tiles/tiles.json",
      tileSize: 256,
    },
  },
  layers: [
    {
      id: "satellite",
      type: "raster",
      source: "satellite",
      paint: {
        "raster-saturation": -0.08,
        "raster-contrast": 0.12,
        "raster-brightness-min": 0.02,
        "raster-brightness-max": 0.92,
      },
    },
    {
      id: "terrain-hillshade",
      type: "hillshade",
      source: "terrain",
      paint: {
        "hillshade-exaggeration": 0.28,
        "hillshade-shadow-color": "#102235",
        "hillshade-highlight-color": "#dbe7ef",
        "hillshade-accent-color": "#6b7f8f",
      },
    },
  ],
  terrain: {
    source: "terrain",
    exaggeration: 1.55,
  },
};

export default function HazardMap({
  riskZone,
  villages = [],
  roadSegments = [],
  latestRiskAssessment,
}) {
  if (!riskZone) {
    return <div>Risk zone data unavailable.</div>;
  }

  const latitude = Number(riskZone.latitude);
  const longitude = Number(riskZone.longitude);
  const severity = latestRiskAssessment?.severity || "UNKNOWN";
  const score = latestRiskAssessment?.risk_probability_percent ?? null;
  const color = riskColor(severity);

  const roads = useMemo(
    () => ({
      type: "FeatureCollection",
      features: roadSegments
        .filter((r) =>
          [
            r.start_latitude,
            r.start_longitude,
            r.end_latitude,
            r.end_longitude,
          ].every((v) => Number.isFinite(Number(v)))
        )
        .map((r) => ({
          type: "Feature",
          properties: {
            blocked: Boolean(r.is_blocked),
          },
          geometry: {
            type: "LineString",
            coordinates: [
              [Number(r.start_longitude), Number(r.start_latitude)],
              [Number(r.end_longitude), Number(r.end_latitude)],
            ],
          },
        })),
    }),
    [roadSegments]
  );

  const hazardPoint = useMemo(
    () => ({
      type: "FeatureCollection",
      features: [
        {
          type: "Feature",
          properties: {
            severity,
            risk: score ?? 0,
          },
          geometry: {
            type: "Point",
            coordinates: [longitude, latitude],
          },
        },
      ],
    }),
    [longitude, latitude, severity, score]
  );

  return (
    <div className="hazard-map-3d">
      <Map
        initialViewState={{
          longitude,
          latitude,
          zoom: 11.2,
          pitch: 62,
          bearing: -22,
        }}
        mapStyle={MAP_STYLE}
        maxPitch={78}
        minZoom={6}
        maxZoom={17}
        dragRotate
        touchPitch
        scrollZoom
        attributionControl={true}
        style={{
          width: "100%",
          height: "100%",
        }}
      >
        <NavigationControl position="top-right" showCompass />

        <Source id="hazard-zone" type="geojson" data={hazardPoint}>
          <Layer
            id="hazard-glow"
            type="circle"
            paint={{
              "circle-radius": 38,
              "circle-color": color,
              "circle-opacity": 0.14,
              "circle-blur": 0.72,
              "circle-stroke-color": color,
              "circle-stroke-width": 2,
              "circle-stroke-opacity": 0.38,
            }}
          />
          <Layer
            id="hazard-ring"
            type="circle"
            paint={{
              "circle-radius": 22,
              "circle-color": color,
              "circle-opacity": 0.10,
              "circle-stroke-color": color,
              "circle-stroke-width": 3,
              "circle-stroke-opacity": 0.95,
            }}
          />
        </Source>

        <Source id="roads" type="geojson" data={roads}>
          <Layer
            id="roads-open"
            type="line"
            filter={["==", ["get", "blocked"], false]}
            paint={{
              "line-color": "#25d58d",
              "line-width": 3.5,
              "line-opacity": 0.92,
            }}
          />
          <Layer
            id="roads-blocked"
            type="line"
            filter={["==", ["get", "blocked"], true]}
            paint={{
              "line-color": "#ff4f62",
              "line-width": 5,
              "line-opacity": 0.96,
              "line-dasharray": [2, 2],
            }}
          />
        </Source>

        <Marker longitude={longitude} latitude={latitude} anchor="center">
          <div
            className="risk-3d-marker"
            style={{
              "--risk-color": color,
            }}
            title={`${riskZone.name} - ${severity} - ${score ?? "N/A"}%`}
          >
            <span />
          </div>
        </Marker>

        {villages
          .filter(
            (v) =>
              Number.isFinite(Number(v.latitude)) &&
              Number.isFinite(Number(v.longitude))
          )
          .map((v) => (
            <Marker
              key={v.public_id}
              longitude={Number(v.longitude)}
              latitude={Number(v.latitude)}
              anchor="bottom"
            >
              <div
                className="village-3d-marker"
                title={v.name}
              />
            </Marker>
          ))}

        <Popup
          longitude={longitude}
          latitude={latitude}
          closeButton={true}
          closeOnClick={false}
          anchor="bottom"
          offset={28}
          className="hazard-map-popup"
        >
          <div className="hazard-popup">
            <div className="hazard-popup-title">{riskZone.name}</div>
            <span>
              {riskZone.district}, {riskZone.state}
            </span>
            <span>
              Severity: <b>{severity}</b>
            </span>
            <span>
              Risk: <b>{score !== null ? `${score}%` : "N/A"}</b>
            </span>
            {riskZone.slope_degrees !== null &&
            riskZone.slope_degrees !== undefined ? (
              <span>
                Slope: <b>{riskZone.slope_degrees} deg</b>
              </span>
            ) : null}
          </div>
        </Popup>
      </Map>

      <div className="map-3d-badge">
        <span className="map-3d-pulse" />
        3D TERRAIN
      </div>

      <div className="map-3d-hint">
        Drag to rotate - Scroll to zoom
      </div>
    </div>
  );
}
